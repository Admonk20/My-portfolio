# ─── Airtable ────────────────────────────────────────────────
# Create a personal access token at https://airtable.com/create/tokens
#   • Scopes: data.records:read, data.records:write
#   • Access: add your portfolio base
AIRTABLE_PERSONAL_ACCESS_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Base ID. Open your base on airtable.com, then look at the URL:
#   https://airtable.com/{BASE_ID}/{TABLE_ID}/{VIEW_ID}
# The base ID starts with "app...".
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─── Contact ─────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro
NEXT_PUBLIC_SOCIAL_X=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/your-handle
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-handle
