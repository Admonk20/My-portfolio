# ─── Admin auth ──────────────────────────────────────────────
# The single password that unlocks /admin. Choose something long.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Used to sign the admin session cookie. Any long random string.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# ─── Supabase ────────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Contact ─────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro
NEXT_PUBLIC_SOCIAL_X=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/your-handle
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-handle
